# Secret key for Flask session signing, CSRF protection, and security cookies
SECRET_KEY=your-secret-key-here-change-in-production

# Database connection URI (defaults to SQLite database/mediguide.db if unset)
DATABASE_URL=sqlite:///database/mediguide.db

# Alternative database URI environment variable accepted by config.py
SQLALCHEMY_DATABASE_URI=sqlite:///database/mediguide.db

# Google Gemini API key used for the AI medical chatbot and report analyzer
GEMINI_API_KEY=your-google-gemini-api-key-here

# Enable Flask debug mode for live reloading (True for development, False for production)
FLASK_DEBUG=True
